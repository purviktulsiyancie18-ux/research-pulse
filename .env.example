# Neon pooled connection string (console.neon.tech → project → Connect → pooled)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Google AI Studio (aistudio.google.com → Get API key). Gemini Flash only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Resend (resend.com → API Keys → Create, sending access)
RESEND_API_KEY=
EMAIL_FROM=Research Pulse <onboarding@resend.dev>
# Must be your Resend account email while sending from onboarding@resend.dev
DEFAULT_RECIPIENT=

# openssl rand -hex 32
CRON_SECRET=
# Production URL, no trailing slash
APP_URL=http://localhost:3000

# Optional
S2_API_KEY=
ADMIN_PASSCODE=
SESSION_SECRET=
TEST_MODE=false
MOCK_GEMINI=false
